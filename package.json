{
  "name": "react-text-underline",
  "version": "1.0.2",
  "description": "Premium text highlight & underline effects for React — marker, brushstroke, gradient, slide, glow, scratch, double, wave",
  "keywords": [
    "react",
    "text",
    "highlight",
    "underline",
    "animation",
    "marker",
    "tailwind",
    "ui",
    "component"
  ],
  "author": "Exaland Concept <exaland@gmail.com>",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exaland/react-text-underline.git"
  }
}
